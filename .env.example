# AURA — Air Quality GenAI Assistant
# copy to `.env` and fill in, or set env vars before `npm start`

# --- Gemini (GenAI engine) ---
# Get a free key: https://aistudio.google.com/ (no card required, free tier)
GEMINI_API_KEY=

# Free-tier model. Default is gemini-3.5-flash-lite (500 req/day free).
# Others that are free: gemini-3.1-flash-lite, gemini-2.5-flash-lite,
# gemini-4-hydrogen, gemini-3.8-flash (20 req/day).
GEMINI_MODEL=gemini-3.5-flash-lite

# Port
PORT=3000
