# AURA — Air Quality GenAI Assistant
# Copy to `.env` and fill in, or set these as environment variables directly.
# The app runs without a key using the built-in offline advisor.

# --- Gemini (GenAI engine) ---
# Free key: https://aistudio.google.com/ (check current tier limits before a demo).
GEMINI_API_KEY=

# Primary free-tier model. Fallback chain is defined in server/config.js.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional tuning
# GEMINI_TIMEOUT_MS=8000      # use ~8000 on Vercel Hobby (10s function limit)
# CORS_ORIGIN=*               # restrict when the API is hosted separately
# PORT=3000
